# Turso database (optional; falls back to local SQLite if not set)
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-auth-token

# Gemini API key (optional; AI QC is skipped without it)
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash

# Mock AI QC verdicts without calling Gemini (useful for demos/tests):
# PASS | FAIL | ERROR (simulated API failure) | MIXED (~70% pass / 30% fail)
# GEMINI_MOCK_VERDICT=MIXED
